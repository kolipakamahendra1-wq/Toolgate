# Copy to .env. Everything has a working default; none of this is required for local runs.
LLM_PROVIDER=ollama            # ollama | openai (any OpenAI-compatible endpoint) | none
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
EMBED_PROVIDER=hash            # hash (no model) | ollama (nomic-embed-text)
EMBED_MODEL=nomic-embed-text
TOOLGATE_MAX_ROWS=50
# Demo tokens are public. Replace for anything beyond a demo: {"your-secret":"analyst"}
# TOOLGATE_TOKENS={"tg-analyst":"analyst","tg-hr":"hr_admin","tg-support":"support"}
